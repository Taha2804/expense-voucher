# Copy to .env and adjust. Every variable here is required unless marked optional.

# Node environment: development | test | production
NODE_ENV=development

# Port the API listens on. The frontend dev server proxies /api here.
PORT=4000

# PostgreSQL connection string. Matches the docker-compose service.
DATABASE_URL="postgresql://voucher:voucher@localhost:5432/voucher_db?schema=public"

# Signing key for the session JWT. Minimum 32 characters, no default.
# Generate one with: openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# JWT lifetime, as accepted by jsonwebtoken (e.g. 8h, 30m, 7d).
JWT_EXPIRES_IN=8h

# Origin allowed to send credentialed requests. The Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Directory signature images are written to, relative to the backend package.
UPLOAD_DIR=uploads/signatures

# Maximum signature upload size in bytes (2 MB).
MAX_UPLOAD_BYTES=2097152

# Timezone used for every "today" calculation on the dashboards.
TZ=Asia/Kolkata
