# Copy to .env.test to override the suite's defaults. Optional: without this
# file the suite uses the stock docker-compose stack and the voucher_test
# database created by docker/init-test-db.sql.
#
# Never point this at the development database. The suite truncates tables.
DATABASE_URL="postgresql://voucher:voucher@localhost:5432/voucher_test?schema=public"
JWT_SECRET="test-secret-that-is-at-least-32-characters-long"
